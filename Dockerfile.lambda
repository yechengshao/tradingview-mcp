# ARM64 manifests resolved from upstream registries during implementation.
FROM ghcr.io/astral-sh/uv:0.13.1@sha256:c4ca260ce2a921fb9ea59c6619d4c88c34990b4272524115ab61a70b647d2755 AS uv
FROM public.ecr.aws/awsguru/aws-lambda-adapter:1.1.0@sha256:98d6d1dc9ad3f18c6af7baaa397fb033a57d82f5bffb58ff33bef1c2e1f4f0fe AS adapter
FROM python:3.11-slim@sha256:8f867a1f16776618234a2d0ef41fbb991d0bd0b142c8a95bc37456d8e47104cf AS builder
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy PYTHONDONTWRITEBYTECODE=1
COPY pyproject.toml uv.lock README.md ./
COPY src/ ./src/
RUN uv sync --locked --no-dev --no-editable --python /usr/local/bin/python3.11

FROM python:3.11-slim@sha256:8f867a1f16776618234a2d0ef41fbb991d0bd0b142c8a95bc37456d8e47104cf
ARG SOURCE_COMMIT
ARG SOURCE_DIRTY=true
ARG LOCK_SHA256
LABEL org.opencontainers.image.revision=$SOURCE_COMMIT \
      tradingview.source-dirty=$SOURCE_DIRTY \
      tradingview.lock-sha256=$LOCK_SHA256 \
      tradingview.adapter-version="1.1.0" tradingview.builder-version="0.13.1"
WORKDIR /app
COPY --from=builder /app/.venv /app/.venv
COPY --from=adapter /lambda-adapter /opt/extensions/lambda-adapter
ENV PATH="/app/.venv/bin:$PATH" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    HOME=/tmp TMPDIR=/tmp AWS_LWA_PORT=8000 \
    AWS_LWA_READINESS_CHECK_PATH=/health AWS_LWA_READINESS_CHECK_HEALTHY_STATUS=200 \
    AWS_LWA_INVOKE_MODE=buffered
RUN chmod -R a+rX /app /opt/extensions && useradd --no-create-home --uid 10001 mcpuser
USER 10001:10001
EXPOSE 8000
ENTRYPOINT ["/app/.venv/bin/python", "-m", "tradingview_mcp.lambda_server"]
